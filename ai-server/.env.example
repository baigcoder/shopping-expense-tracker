# AI Server Environment Variables
# Copy this to .env and fill in your values
# Never put these keys in VITE_ frontend variables.

# Groq API Key (fast document parsing + LLM fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_DOCUMENT_MODEL=llama-3.3-70b-versatile

# Optional: OpenRouter fallback
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Server Configuration (Railway sets PORT automatically)
# PORT=8000
