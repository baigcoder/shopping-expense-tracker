{
  "manifest_version": 3,
  "name": "Cashly - Smart Expense Tracker",
  "version": "9.1.2",
  "description": "Review online purchases in Cashly before they reach your finance ledger.",
  "short_name": "Cashly",
  "author": "BaigCoder",
  "homepage_url": "https://cashly.app",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "tabs",
    "scripting",
    "alarms"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "https://*.vercel.app/*",
      "https://vibe-tracker-expense-genz.vercel.app/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cashly - Review-First Finance",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.vercel.app/*"
      ],
      "js": [
        "content-website.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "exclude_matches": [
        "http://localhost/*",
        "http://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "config.js",
        "content.css",
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png",
        "icons/logo.png"
      ],
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*/*"
      ]
    }
  ]
}
