# Cashly Frontend Environment Variables

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Data Connect / SQL Connect service name
VITE_FIREBASE_DATA_CONNECT_SERVICE=

# Supabase (auth + extension sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_PUBLIC_SITE_URL=https://your-frontend.vercel.app
# Supabase Dashboard → Auth → URL Configuration must include:
#   {VITE_PUBLIC_SITE_URL}/auth/callback
#   http://localhost:5173/auth/callback
# Google Cloud OAuth redirect URI:
#   https://your-project.supabase.co/auth/v1/callback

# Backend API URL (optional - defaults to /api proxy in dev)
VITE_API_URL=http://localhost:5000/api
# Used by the Vercel /api proxy at runtime when the frontend is deployed
BACKEND_API_URL=https://your-backend.example.com/api

# ElevenLabs (for voice AI)
VITE_ELEVENLABS_API_KEY=

# Feature Flags (optional)
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_EXTENSION=true
