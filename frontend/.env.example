# Cashly Frontend Environment Variables

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Data Connect / SQL Connect service name
VITE_FIREBASE_DATA_CONNECT_SERVICE=

# Supabase (used for extension sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend API URL (optional - defaults to /api proxy in dev)
VITE_API_URL=http://localhost:5000/api

# ElevenLabs (for voice AI)
VITE_ELEVENLABS_API_KEY=

# Feature Flags (optional)
VITE_ENABLE_AI_INSIGHTS=true
VITE_ENABLE_EXTENSION=true
