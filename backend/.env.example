# ====================================================================
# CASHLY BACKEND V11 — ENVIRONMENT CONFIGURATION TEMPLATE
# ====================================================================

# Server
PORT=5000
NODE_ENV=production

# ====================================================================
# SUPABASE CONFIGURATION
# IMPORTANT: All three values MUST belong to the EXACT same project!
# ====================================================================
# Project REST Gateway URL: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Anonymous Public Key (used for public / user-scoped requests and token verification)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_jwt_payload_here

# Service-Role Secret Key (used ONLY for server-privileged admin operations; NEVER expose to clients)
# Payload 'ref' claim MUST match <project-ref> in SUPABASE_URL above!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_jwt_payload_here

# ====================================================================
# DATABASE CONFIGURATION (PostgreSQL / Supabase Transaction Pooler)
# ====================================================================
# Primary pooled connection string (port 6543, pgbouncer=true)
DATABASE_URL=postgresql://postgres.your-project-ref:your_strong_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection string for schema migrations (port 5432)
DIRECT_URL=postgresql://postgres:your_strong_password@db.your-project-ref.supabase.co:5432/postgres

# Set to false if running purely on Supabase PostgREST layer
AUTH_DB_SYNC_ENABLED=false

# ====================================================================
# AUTHENTICATION & SECURITY
# ====================================================================
JWT_SECRET=your_secure_random_jwt_secret_min_32_characters_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
FRONTEND_URL=https://cashly.app
FRONTEND_URLS=https://cashly.app,http://localhost:5173,http://localhost:5174

# ====================================================================
# BANKING INTEGRATION (Plaid Sandbox / Production)
# ====================================================================
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# ====================================================================
# AI SERVICES (OpenRouter / Groq / ElevenLabs)
# ====================================================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx
OPENROUTER_APP_NAME=Cashly
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FAST_CHAT_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_ANALYSIS_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FORECAST_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
OPENROUTER_RISK_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_VOICE_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_DOCUMENT_MODEL=inclusionai/ling-2.6-1t:free

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_DOCUMENT_MODEL=llama-3.3-70b-versatile

# ElevenLabs Voice AI (Server-only TTS)
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# ====================================================================
# REDIS CLUSTER / CACHE
# ====================================================================
REDIS_URL=redis://default:password@host:port

# ====================================================================
# TRANSACTIONAL EMAIL (SMTP)
# ====================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@cashly.app
