{
    "version": 2,
    "crons": [
        { "path": "/api/cron/trial-reminders", "schedule": "0 8 * * *" }
    ],
    "buildCommand": "",
    "outputDirectory": ".",
    "builds": [
        {
            "src": "api/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "api/index.ts"
        }
    ]
}